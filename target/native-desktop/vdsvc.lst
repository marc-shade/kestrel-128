=6					SM_INFO=6                    ; TOKEN: version, lease, active, probe-live, pending
=7					SM_OPEN=7                    ; acquire lease / retry a retained probe restore
=8					SM_ALLOC=8                   ; PAGES in; TOKEN and PAGE out
=9					SM_READ=9                    ; TOKEN/OFFSET/COUNT in; COUNT=completed bytes out
=10					SM_WRITE=10                  ; same, N_BUFFER is never used for descriptors
=11					SM_FREE=11                   ; TOKEN in
=12					SM_RESIZE=12                 ; TOKEN/PAGES in; replacement TOKEN/PAGE on success
=13					SM_CLOSE=13                  ; refuse live documents; release only memory lease
=14					SM_STATS=14                  ; PAGES=total, PAGE=available, TOKEN=free slots
=$3d00					SM_TOKEN=$3d00               ; eight-byte opaque token; INFO bytes 5..7 reserved
=$3d08					SM_OFFSET=$3d08              ; 24-bit byte offset within extent
=$3d0b					SM_COUNT=$3d0b               ; 16-bit transfer length, 1..512 / actual on return
=$3d0d					SM_PAGES=$3d0d               ; 16-bit count of 4096-byte pages
=$3d0f					SM_PAGE=$3d0f                ; 16-bit first page / available pages
=1					SM_VERSION=1
=33					SM_OWNER=N_APPOWNER+1

